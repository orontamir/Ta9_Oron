{
  "Logging": {
    "UseJsonConsole": true,
    "Console": {
      "MinimumLevel": "Information"
    },
    "Mongo": {
      "Enabled": true,
      "ConnectionString": "mongodb://localhost:27017",
      "Database": "ta9_logs",
      "Collection": "logs",
      "MinimumLevel": "Debug",
      "RetentionDays": 7,
      "BatchSize": 100,
      "FlushInterval": "00:00:01",
      "QueueCapacity": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Processing": {
    "MaxConcurrentJobs": 10,
    "QueueCapacity": 100,
    "DocParallelismPerJob": 2,
    "ResultsTtl": "01:00:00",
    "RetryAfterSeconds": 5
  },
  "JobServiceEvents": {
    "Url": "ws://localhost:5001/ws/processor-events",
    "OutboxCapacity": 10000,
    "AckTimeout": "00:00:30",
    "ResendCheckInterval": "00:00:05",
    "ReconnectInitialDelay": "00:00:01",
    "ReconnectMaxDelay": "00:00:30"
  }
}
