{
  "Logging": {
    "UseJsonConsole": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Processing": {
    "MaxConcurrentJobs": 10,
    "QueueCapacity": 100,
    "DocParallelismPerJob": 2,
    "ResultsTtl": "01:00:00",
    "RetryAfterSeconds": 5
  }
}
