{
  "Logging": {
    "UseJsonConsole": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Processing": {
    "MaxConcurrentJobs": 10,
    "QueueCapacity": 100,
    "DocParallelismPerJob": 2,
    "ResultsTtl": "01:00:00",
    "RetryAfterSeconds": 5
  },
  "JobServiceEvents": {
    "Url": "ws://localhost:5001/ws/processor-events",
    "OutboxCapacity": 10000,
    "AckTimeout": "00:00:30",
    "ResendCheckInterval": "00:00:05",
    "ReconnectInitialDelay": "00:00:01",
    "ReconnectMaxDelay": "00:00:30"
  }
}
