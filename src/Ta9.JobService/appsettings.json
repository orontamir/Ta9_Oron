{
  "Logging": {
    "UseJsonConsole": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Mongo",
    "Mongo": {
      "ConnectionString": "mongodb://localhost:27017",
      "Database": "ta9_jobs"
    }
  },
  "Processor": {
    "BaseUrl": "http://localhost:5002/",
    "RequestTimeout": "00:00:30",
    "CancelTimeout": "00:00:03"
  },
  "Dispatch": {
    "Enabled": true,
    "MaxDispatchAttempts": 5,
    "InitialBackoff": "00:00:02",
    "MaxBackoff": "00:01:00",
    "PollInterval": "00:00:01",
    "LeaseDuration": "00:02:00",
    "MaxParallelDispatches": 4
  }
}
