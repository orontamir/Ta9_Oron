{
  "Logging": {
    "UseJsonConsole": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Mongo",
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "ta9_audit"
  }
}
