{
  "Logging": {
    "UseJsonConsole": true,
    "Console": {
      "MinimumLevel": "Information"
    },
    "Mongo": {
      "Enabled": true,
      "ConnectionString": "mongodb://localhost:27017",
      "Database": "ta9_logs",
      "Collection": "logs",
      "MinimumLevel": "Debug",
      "RetentionDays": 7,
      "BatchSize": 100,
      "FlushInterval": "00:00:01",
      "QueueCapacity": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Mongo",
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "ta9_audit"
  }
}
