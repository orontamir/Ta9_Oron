"1"><mxGeometry x="650" y="90" width="220" height="88" as="geometry"/></mxCell><mxCell id="n127" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;JobRunner&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ RunAsync(job, stoppingToken)&lt;br&gt;  Parallel.ForEachAsync (DOP 2)&lt;br&gt;  per-document try/catch&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="260" height="87" as="geometry"/></mxCell><mxCell id="n128" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ProgressThrottle&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ ShouldReport(processed): bool&lt;br&gt;  every 10% or 2 s, never 100%&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="910" y="260" width="260" height="72" as="geometry"/></mxCell><mxCell id="n129" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IDocumentAnalyzer&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ Analyze(content): DocumentAnalysis&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F3E5F5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1220" y="90" width="260" height="73" as="geometry"/></mxCell><mxCell id="n130" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;DocumentAnalyzer&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;word / unique counts, top 5,&lt;br&gt;SHA-256, lines, avg &amp;amp; longest word&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1220" y="220" width="260" height="72" as="geometry"/></mxCell><mxCell id="n131" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«static»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Tokenizer&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ Tokenize(text): IReadOnlyList&amp;lt;string&amp;gt;&lt;br&gt;  Unicode · NFC · case-insensitive&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1220" y="360" width="260" height="88" as="geometry"/></mxCell><mxCell id="n132" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«record»&lt;/i&gt;&lt;br&gt;&lt;b&gt;DocumentAnalysis&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;WordCount, UniqueWordCount&lt;br&gt;TopWords: WordFrequency[]&lt;br&gt;Sha256, CharacterCount, LineCount&lt;br&gt;AverageWordLength, LongestWord&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1520" y="220" width="260" height="118" as="geometry"/></mxCell><mxCell id="n133" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IJobEventPublisher&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ JobStarted / JobProgress&lt;br&gt;+ JobCompleted / JobFailed / JobCancelled&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F3E5F5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="910" y="440" width="260" height="88" as="geometry"/></mxCell><mxCell id="n134" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;WebSocketJobEventPublisher&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;builds envelopes, never blocks&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ECEFF1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="910" y="600" width="260" height="57" as="geometry"/></mxCell><mxCell id="n135" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;EventOutbox&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ TryAddLifecycle(envelope): bool&lt;br&gt;+ OfferProgress(envelope)&lt;br&gt;+ TakeDue(ackTimeout)&lt;br&gt;+ Acknowledge(eventId)&lt;br&gt;+ MarkConnected() / MarkDisconnected()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ECEFF1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="910" y="720" width="300" height="117" as="geometry"/></mxCell><mxCell id="n136" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«BackgroundService»&lt;/i&gt;&lt;br&gt;&lt;b&gt;JobServiceEventsClient&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;connect → replay → send / receive acks&lt;br&gt;exponential backoff + jitter&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ECEFF1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1260" y="720" width="260" height="88" as="geometry"/></mxCell><mxCell id="n137" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IWebSocketConnector&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0