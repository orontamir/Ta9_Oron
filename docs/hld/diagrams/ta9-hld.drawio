quot;&gt;&lt;b&gt;ProcessorEventsEndpoint&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ HandleAsync(HttpContext)&lt;br&gt;  receive → handle → ack&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="230" height="72" as="geometry"/></mxCell><mxCell id="n67" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;JobEventStream&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ StreamAsync(jobId, response)&lt;br&gt;  subscribe → snapshot → updates&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E8F5E9;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="230" height="72" as="geometry"/></mxCell><mxCell id="n68" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;JobManager&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ CreateAsync(command): Job&lt;br&gt;+ GetResultsAsync(id, page)&lt;br&gt;+ CancelAsync(id)&lt;br&gt;+ DeleteAsync(id)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="102" as="geometry"/></mxCell><mxCell id="n69" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ProcessorEventHandler&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ HandleAsync(envelope)&lt;br&gt;+ ApplyRemoteStatusAsync(id, status)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="230" height="72" as="geometry"/></mxCell><mxCell id="n70" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«BackgroundService»&lt;/i&gt;&lt;br&gt;&lt;b&gt;JobDispatcher&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ DispatchDueJobsAsync()&lt;br&gt;- ApplyAsync(outcome)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="230" height="88" as="geometry"/></mxCell><mxCell id="n71" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«BackgroundService»&lt;/i&gt;&lt;br&gt;&lt;b&gt;JobReconciler&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ ReconcileOnceAsync()&lt;br&gt;- RecoverLostJobAsync()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="230" height="88" as="geometry"/></mxCell><mxCell id="n72" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«BackgroundService»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AuditPublisher&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ PublishPendingAsync()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="230" height="73" as="geometry"/></mxCell><mxCell id="n73" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Job&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ Id: Guid&lt;br&gt;+ Name: string?&lt;br&gt;+ Status: JobStatus&lt;br&gt;+ TotalDocuments / ProcessedDocuments: int&lt;br&gt;+ Summary: ProcessingSummaryDto?&lt;br&gt;+ FailureReason / CorrelationId: string?&lt;br&gt;+ CreatedAt / UpdatedAt / StartedAt / CompletedAt&lt;br&gt;+ DispatchAttempts / RedispatchCount: int&lt;br&gt;+ NextDispatchAt / LeaseUntil: DateTimeOffset?&lt;br&gt;+ AuditPublished: bool&lt;br&gt;+ Version: long  (optimistic token)&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ Create(...): Job&lt;br&gt;+ TryMarkQueued(now): bool&lt;br&gt;+ ScheduleDispatchRetry(at, count, now)&lt;br&gt;+ TryStart / RecordProgress(n, now)&lt;br&gt;+ TryComplete(summary, now)&lt;br&gt;+ TryFail(reason, now) / TryCancel(now)&lt;br&gt;+ TryReturnToPending(now)&lt;br&gt;+ Touch(now) / TryMarkAuditPublished()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="300" height="335" as="geometry"/></mxCell><mxCell id="n74" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«enum»&lt;/i&gt;&lt;br&gt;&lt;b&gt;JobStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;Pending&lt;br&gt;Queued&lt;br&gt;Processing&lt;br&gt;Completed&lt;br&gt;Failed&lt;br&gt;Cancelled&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="160" height="148" as="geometry"/></mxCell><mxCell id="n75" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«static»&lt;/i&gt;&lt;br&gt;&lt;b&gt;JobStateMachine&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ CanTransition(from, to): bool&lt;br&gt;+ IsTerminal(status): bool&lt;br&gt;+ IsActive(status): bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="380" y="760" width="220" height="103" as="geometry"/></mxCell><mxCell id="n76" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;JobDocument&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ Id: &amp;quot;{jobId}-{index}&amp;quot;&lt;br&gt;+ JobId: Guid&lt;br&gt;+ Index: int&lt;br&gt;+ Name / Content: string&lt;br&gt;+ Result: DocumentResultDto?&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="380" y="920" width="220" height="117" as="geometry"/></mxCell><mxCell id="n77" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IJobRepository&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ InsertAsync(job) / GetAsync(id) / ListAsync(...)&lt;br&gt;+ TryUpdateAsync(job): bool  (version check)&lt;br&gt;+ DeleteAsync(id)&lt;br&gt;+ TryClaimNextForDispatchAsync(now, lease)&lt;br&gt;+ FindStaleActiveAsync(before, limit)&lt;br&gt;+ FindUnpublishedTerminalAsync(limit)&lt;br&gt;+ UpdateAsync(id, mutate)  «extension»: load → mutate → retry&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F3E5F5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="330" height="163" as="geometry"/></mxCell><mxCell id="n78" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IJobDocumentRepository&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ InsertManyAsync(documents)&lt;br&gt;+ GetByJobAsync(jobId)&lt;br&gt;+ SaveResultsAsync(