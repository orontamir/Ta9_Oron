1" value="WS endpoint" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="705" y="80" width="130" height="54" as="geometry"/></mxCell><mxCell id="n332" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9E9E9E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="134" as="sourcePoint"/><mxPoint x="770" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n333" value="EventHandler + MongoDB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="925" y="80" width="130" height="54" as="geometry"/></mxCell><mxCell id="n334" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9E9E9E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="134" as="sourcePoint"/><mxPoint x="990" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n335" value="1. TryAddLifecycle(JobCompleted)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="160" as="sourcePoint"/><mxPoint x="330" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n336" value="2. TakeDue() → [JobCompleted]" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="198" as="sourcePoint"/><mxPoint x="550" y="198" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n337" value="3. WS: JobCompleted (eventId E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="236" as="sourcePoint"/><mxPoint x="770" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n338" value="&lt;b&gt;Connection drops&lt;/b&gt; before the ack is sent&lt;br&gt;(Job Service restart / network failure)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="264" width="300" height="46" as="geometry"/></mxCell><mxCell id="n339" value="4. MarkDisconnected() — progress dropped, E1 kept" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="330" as="sourcePoint"/><mxPoint x="330" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n340" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="368" as="sourcePoint"/><mxPoint x="550" y="390" as="targetPoint"/><Array as="points"><mxPoint x="586" y="368"/><mxPoint x="586" y="390"/></Array></mxGeometry></mxCell><mxCell id="n341" value="5. reconnect with exponential backoff&lt;br&gt;1 s → 30 s, ±20% jitter" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="592" y="362" width="220" height="36" as="geometry"/></mxCell><mxCell id="n342" value="6. WS connect (success)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="418" as="sourcePoint"/><mxPoint x="770" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n343" value="7. MarkConnected() → all unacked events due again" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="456" as="sourcePoint"/><mxPoint x="330" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n344" value="8. WS: replay JobCompleted (E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="494" as="sourcePoint"/><mxPoint x="770" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n345" value="9. HandleAsync(E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="532" as="sourcePoint"/><mxPoint x="990" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n346" value="10. Applied — or Ignored if it was already applied" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="570" as="sourcePoint"/><mxPoint x="770" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n347" value="11. WS: ack(E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="608" as="sourcePoint"/><mxPoint x="550" y="608" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n348" value="12. Acknowledge(E1) → removed" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="646" as="sourcePoint"/><mxPoint x="330" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n349" value="Storage failure while handling → &lt;b&gt;no ack&lt;/b&gt;:&lt;br&gt;the outbox resends after the 30 s ack timeout." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="790" y="674" width="300" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page8" name="6. Deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n350" value="&lt;b&gt;Deployment — docker compose&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="n351" value="Client / Postman / Swagger" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="40" height="70" as="geometry"/></mxCell><mxCell id="n352" value="docker compose project &lt;b&gt;ta9&lt;/b&gt; — network ta9_default" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontSize=13;container=1;collapsible=0;rounded=1;arcSize=3;fillColor=#ECEFF1;strokeColor=#78909C;swimlaneFillColor=#FAFBFC;dashed=1;" vertex="1" parent="1"><mxGeometry x="220" y="90" width="1120" height="600" as="geometry"/></mxCell><mxCell id="n353" value="&lt;b&gt;job-service&lt;/b&gt;&lt;br&gt;image ta9/job-service&lt;br&gt;host :5001 → 8080&lt;br&gt;healthcheck: curl /health/ready" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="n352"><mxGeometry x="60" y="80" width="230" height="90" as="geometry"/></mxCell><mxCell id="n354" value="&lt;b&gt;processor-service&lt;/b&gt;&lt;br&gt;image ta9/processor-service&lt;br&gt;host :5002 → 8080&lt;br&gt;10 workers · queue 100 · DOP 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="n352"><mxGeometry x="620" y="80" width="250" height="90" as="geometry"/></mxCell><mxCell id="n355" value="&lt;b&gt;audit-service&lt;/b&gt;&lt;br&gt;image ta9/audit-service&lt;br&gt;host :5003 → 8080" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="n352"><mxGeometry x="620" y="320" width="250" height="80" as="geometry"/></mxCell><mxCell id="n356" value="&lt;b&gt;mongo:7.0&lt;/b&gt;&lt;br&gt;host :27017&lt;br&gt;volume mongo-data&lt;br&gt;healthcheck: mongosh ping" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="n352"><mxGeometry x="80" y="330" width="200" height="120" as="geometry"/></mxCell><mxCell id="n357" value="&lt;b&gt;Build&lt;/b&gt;: one multi-stage Dockerfile (PROJECT build arg), cached restore layer, aspnet:8.0 runtime, non-root user.&lt;br&gt;Restricted networks (TLS inspection): Dockerfile.prebuilt packages host-published binaries.&lt;br&gt;&lt;b&gt;Startup order&lt;/b&gt;: mongo → job-service + audit-service → processor-service (depends_on: service_healthy)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="n352"><mxGeometry x="60" y="490" width="1000" height="80" as="geometry"/></mxCell><mxCell id="n358" value="REST :5001 · SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#1f5fa8;strokeWidth=2;fontColor=#1f5fa8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n351" target="n353"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n359" value="REST http://processor-service:8080/api/process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#1f5fa8;strokeWidth=2;fontColor=#1f5fa8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n353" target="n354"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n360" value="WS ws://job-service:8080/ws/processor-events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#2e7d32;strokeWidth=2;fontColor=#2e7d32;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n354" target="n353"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n361" value="REST http://audit-service:8080/api/audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#1f5fa8;strokeWidth=2;fontColor=#1f5fa8;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n353" target="n355"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="253"/><mxPoint x="580" y="450"/></Array></mxGeometry></mxCell><mxCell id="n362" value="ta9_jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#666666;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n353" target="n356"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="380"/><mxPoint x="400" y="380"/></Array></mxGeometry></mxCell><mxCell id="n363" value="ta9_audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#666666;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="n355" target="n356"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page-concurrency-0" name="7. Concurrency — Processor"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cc1" value="&lt;b&gt;Concurrency model — Processor Service&lt;/b&gt; (bounded producer/consumer, two-level parallelism)" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="cc2" value="&lt;b&gt;Job Service&lt;/b&gt;&lt;br&gt;JobDispatcher&lt;br&gt;≤ 4 dispatches in flight" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="170" height="80" as="geometry"/></mxCell><mxCell id="cc3" value="Processor Service" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;container=1;collapsible=0;rounded=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#F5FAF4;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="1400" height="840" as="geometry"/></mxCell><mxCell id="cc4" value="&lt;b&gt;POST /api/process&lt;/b&gt;&lt;br&gt;ProcessingService.Submit&lt;br&gt;idempotent by jobId" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;" vertex="1" parent="cc3"><mxGeometry x="30" y="170" width="180" height="80" as="geometry"/></mxCell><mxCell id="cc5" value="TryWrite&lt;br&gt;(non-blocking)" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="cc3"><mxGeometry x="250" y="165" width="110" height="90" as="geometry"/></mxCell><mxCell id="cc6" value="503 Service Unavailable&lt;br&gt;Retry-After: 5 s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="cc3"><mxGeometry x="225" y="50" width="160" height="50" as="geometry"/></mxCell><mxCell id="cc7" value="&lt;b&gt;Bounded Channel&amp;lt;ProcessingJob&amp;gt;&lt;/b&gt;&lt;br&gt;capacity 100 · FIFO" style="shape=process;whiteSpace=wrap;html=1;fontSize=11;size=0.06;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="cc3"><mxGeometry x="400" y="165" width="240" height="90" as="geometry"/></mxCell><mxCell id="cc8" value="&lt;b&gt;InMemoryProcessingJobStore&lt;/b&gt;&lt;br&gt;finished jobs evicted after 1 h&lt;br&gt;documents released on finish" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;" vertex="1" parent="cc3"><mxGeometry x="30" y="330" width="200" height="80" as="geometry"/></mxCell><mxCell id="cc9" value="&lt;b&gt;EventOutbox&lt;/b&gt;&lt;br&gt;lifecycle ≤ 10 000 until ack&lt;br&gt;progress: latest per job only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;" vertex="1" parent="cc3"><mxGeometry x="30" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="cc10" value="&lt;b&gt;JobServiceEventsClient&lt;/b&gt;&lt;br&gt;1 send loop + 1 receive loop&lt;br&gt;async socket I/O" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;dashed=1;" vertex="1" parent="cc3"><mxGeometry x="30" y="720" width="200" height="80" as="geometry"/></mxCell><mxCell id="cc11" value="&lt;b&gt;Bounded everywhere&lt;/b&gt;&lt;br&gt;• waiting jobs ≤ 100 (then 503)&lt;br&gt;• running jobs ≤ 10&lt;br&gt;• CPU work items ≤ 20&lt;br&gt;• outbox ≤ 10 000 events&lt;br&gt;• body ≤ 10 MB · document ≤ 100 KB · ≤ 1 000 docs" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="cc3"><mxGeometry x="1060" y="700" width="300" height="125" as="geometry"/></mxCell><mxCell id="cc12" value="Worker pool — MaxConcurrentJobs = 10 long-lived loops · idle workers await the channel (no thread held)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontSize=11;container=1;collapsible=0;rounded=1;arcSize=3;fillColor=#F1F8E9;strokeColor=#7CB342;swimlaneFillColor=#FCFEFA;" vertex="1" parent="cc3"><mxGeometry x="690" y="50" width="680" height="620" as="geometry"/></mxCell><mxCell id="cc13" value="&lt;b&gt;Worker 1&lt;/b&gt;&lt;br&gt;JobRunner" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;" vertex="1" parent="cc12"><mxGeometry x="20" y="55" width="110" height="60" as="geometry"/></mxCell><mxCell id="cc14" value="Parallel.ForEachAsync · DOP = 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#AED581;dashed=1;" vertex="1" parent="cc12"><mxGeometry x="160" y="49" width="310" height="72" as="geometry"/></mxCell><mxCell id="cc15" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="172" y="77" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc16" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="323" y="77" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#888888;endSize=6;" edge="1" parent="cc12" source="cc13" target="cc14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cc18" value="&lt;b&gt;Worker 2&lt;/b&gt;&lt;br&gt;JobRunner" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;" vertex="1" parent="cc12"><mxGeometry x="20" y="145" width="110" height="60" as="geometry"/></mxCell><mxCell id="cc19" value="Parallel.ForEachAsync · DOP = 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#AED581;dashed=1;" vertex="1" parent="cc12"><mxGeometry x="160" y="139" width="310" height="72" as="geometry"/></mxCell><mxCell id="cc20" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="172" y="167" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc21" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="323" y="167" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#888888;endSize=6;" edge="1" parent="cc12" source="cc18" target="cc19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cc23" value="&lt;b&gt;Worker 3&lt;/b&gt;&lt;br&gt;JobRunner" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;" vertex="1" parent="cc12"><mxGeometry x="20" y="235" width="110" height="60" as="geometry"/></mxCell><mxCell id="cc24" value="Parallel.ForEachAsync · DOP = 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#AED581;dashed=1;" vertex="1" parent="cc12"><mxGeometry x="160" y="229" width="310" height="72" as="geometry"/></mxCell><mxCell id="cc25" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="172" y="257" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc26" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="323" y="257" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#888888;endSize=6;" edge="1" parent="cc12" source="cc23" target="cc24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cc28" value="⋮" style="text;html=1;fontSize=24;align=center;verticalAlign=middle;" vertex="1" parent="cc12"><mxGeometry x="55" y="315" width="40" height="60" as="geometry"/></mxCell><mxCell id="cc29" value="&lt;b&gt;Worker 10&lt;/b&gt;&lt;br&gt;JobRunner" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82b366;" vertex="1" parent="cc12"><mxGeometry x="20" y="385" width="110" height="60" as="geometry"/></mxCell><mxCell id="cc30" value="Parallel.ForEachAsync · DOP = 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#AED581;dashed=1;" vertex="1" parent="cc12"><mxGeometry x="160" y="379" width="310" height="72" as="geometry"/></mxCell><mxCell id="cc31" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="172" y="407" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc32" value="analyze document" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#C8E6C9;strokeColor=#2E7D32;" vertex="1" parent="cc12"><mxGeometry x="323" y="407" width="135" height="34" as="geometry"/></mxCell><mxCell id="cc33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#888888;endSize=6;" edge="1" parent="cc12" source="cc29" target="cc30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cc34" value="&lt;b&gt;≤ 10 × 2 = 20&lt;/b&gt;&lt;br&gt;CPU work items at once&lt;br&gt;on thread-pool threads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFDE7;strokeColor=#FBC02D;" vertex="1" parent="cc12"><mxGeometry x="495" y="200" width="160" height="80" as="geometry"/></mxCell><mxCell id="cc35" value="• per-document try/catch: one bad document never fails the job&lt;br&gt;• cooperative cancellation (job token + shutdown token)&lt;br&gt;• progress throttled to every 10 % or 2 s&lt;br&gt;• a large job never starves small ones: each job has its own 2 slots" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#33691E;" vertex="1" parent="cc12"><mxGeometry x="20" y="480" width="640" height="80" as="geometry"/></mxCell><mxCell id="cc36" value="REST POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#1f5fa8;strokeWidth=2;fontColor=#1f5fa8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc2" target="cc4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#888888;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc4" target="cc5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc38" value="202 Accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc5" target="cc7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc39" value="full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#C62828;fontColor=#C62828;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc5" target="cc6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc40" value="back-pressure: retry after hint&lt;br&gt;(attempt not counted)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#C62828;fontColor=#C62828;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc6" target="cc2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="165"/></Array></mxGeometry></mxCell><mxCell id="cc41" value="ReadAllAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc7" target="cc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#888888;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc4" target="cc8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc43" value="JobStarted · JobProgress · JobCompleted / JobFailed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc12" target="cc9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1052" y="690"/></Array></mxGeometry></mxCell><mxCell id="cc44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#888888;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc9" target="cc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page-concurrency-1" name="8. Concurrency — Job Service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cc45" value="&lt;b&gt;Concurrency control — Job Service&lt;/b&gt; (many writers, one consistent job state)" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="cc46" value="&lt;b&gt;REST API requests&lt;/b&gt;&lt;br&gt;many concurrent, fully async&lt;br&gt;(create · cancel · delete)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="cc47" value="&lt;b&gt;JobDispatcher&lt;/b&gt; (background)&lt;br&gt;signal or 1 s poll · ≤ 4 in flight" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="80" as="geometry"/></mxCell><mxCell id="cc48" value="&lt;b&gt;ProcessorEventsEndpoint&lt;/b&gt;&lt;br&gt;1 sequential loop per processor&lt;br&gt;connection → events in order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="240" height="80" as="geometry"/></mxCell><mxCell id="cc49" value="&lt;b&gt;JobReconciler&lt;/b&gt; (background)&lt;br&gt;every 30 s · stale jobs only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="240" height="70" as="geometry"/></mxCell><mxCell id="cc50" value="&lt;b&gt;AuditPublisher&lt;/b&gt; (background)&lt;br&gt;every 5 s · outbox flag" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="240" height="70" as="geometry"/></mxCell><mxCell id="cc51" value="&lt;b&gt;Atomic claim&lt;/b&gt; — findOneAndUpdate&lt;br&gt;Pending ∧ due ∧ no live lease&lt;br&gt;→ set leaseUntil (now + 2 min)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="90" width="380" height="80" as="geometry"/></mxCell><mxCell id="cc52" value="&lt;b&gt;UpdateAsync(jobId, mutate)&lt;/b&gt; — optimistic concurrency&lt;br&gt;&lt;br&gt;1. load the job (version &lt;i&gt;v&lt;/i&gt;)&lt;br&gt;2. mutate through the state machine (Try*);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;illegal transition → nothing written&lt;br&gt;3. replace &lt;i&gt;where _id = id AND version = v&lt;/i&gt; → v + 1&lt;br&gt;4. conflict → reload and retry (≤ 5 attempts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#FFFFFF;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="250" width="380" height="190" as="geometry"/></mxCell><mxCell id="cc53" value="&lt;b&gt;MongoDB — jobs&lt;/b&gt;&lt;br&gt;{ _id, status, …, version }" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="240" width="240" height="120" as="geometry"/></mxCell><mxCell id="cc54" value="&lt;b&gt;BroadcastingJobRepository&lt;/b&gt;&lt;br&gt;publishes every successful write" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#7b1fa2;" vertex="1" parent="1"><mxGeometry x="430" y="520" width="380" height="60" as="geometry"/></mxCell><mxCell id="cc55" value="Per-subscriber channel&lt;br&gt;&lt;b&gt;bounded 16 · drop-oldest&lt;/b&gt;&lt;br&gt;a slow client never blocks writers" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fontSize=11;fillColor=#F3E5F5;strokeColor=#7b1fa2;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="240" height="100" as="geometry"/></mxCell><mxCell id="cc56" value="SSE clients&lt;br&gt;snapshot + every change" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#7b1fa2;" vertex="1" parent="1"><mxGeometry x="1320" y="515" width="170" height="70" as="geometry"/></mxCell><mxCell id="cc57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc46" target="cc52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeCol