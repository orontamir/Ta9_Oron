ry x="40" y="90" width="240" height="87" as="geometry"/></mxCell><mxCell id="n120" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ProcessingService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ Submit(request): SubmitResult&lt;br&gt;+ Get(jobId) / List()&lt;br&gt;+ Cancel(jobId): CancelOutcome&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#E3F2FD;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="240" height="87" as="geometry"/></mxCell><mxCell id="n121" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ProcessingJob&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ JobId: Guid&lt;br&gt;+ Status: ProcessingStatus&lt;br&gt;+ TotalDocuments / ProcessedDocuments&lt;br&gt;+ CorrelationId: string?&lt;br&gt;+ CancellationToken&lt;br&gt;- lock-guarded state&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ TryStart(now) / IncrementProcessed()&lt;br&gt;+ TryComplete(results, summary, now)&lt;br&gt;+ TryFail(reason, now) / TryCancel(now)&lt;br&gt;+ ToResponse(includeResults)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFF8E1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="280" height="200" as="geometry"/></mxCell><mxCell id="n122" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IProcessingJobStore&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ TryAdd / TryGet / GetAll / Remove&lt;br&gt;+ RemoveFinishedBefore(cutoff)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F3E5F5;strokeColor