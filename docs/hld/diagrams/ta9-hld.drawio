ddLifecycle(JobCompleted)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="160" as="sourcePoint"/><mxPoint x="330" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n336" value="2. TakeDue() → [JobCompleted]" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="198" as="sourcePoint"/><mxPoint x="550" y="198" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n337" value="3. WS: JobCompleted (eventId E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="236" as="sourcePoint"/><mxPoint x="770" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n338" value="&lt;b&gt;Connection drops&lt;/b&gt; before the ack is sent&lt;br&gt;(Job Service restart / network failure)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="264" width="300" height="46" as="geometry"/></mxCell><mxCell id="n339" value="4. MarkDisconnected() — progress dropped, E1 kept" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="330" as="sourcePoint"/><mxPoint x="330" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n340" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="368" as="sourcePoint"/><mxPoint x="550" y="390" as="targetPoint"/><Array as="points"><mxPoint x="586" y="368"/><mxPoint x="586" y="390"/></Array></mxGeometry></mxCell><mxCell id="n341" value="5. reconnect with exponential backoff&lt;br&gt;1 s → 30 s, ±20% jitter" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="592" y="362" width="220" height="36" as="geometry"/></mxCell><mxCell id="n342" value="6. WS connect (success)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="418" as="sourcePoint"/><mxPoint x="770" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n343" value="7. MarkConnected() → all unacked events due again" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="456" as="sourcePoint"/><mxPoint x="330" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n344" value="8. WS: replay JobCompleted (E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="494" as="sourcePoint"/><mxPoint x="770" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n345" value="9. HandleAsync(E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="532" as="sourcePoint"/><mxPoint x="990" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n346" value="10. Applied — or Ignored if it was already applied" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="570" as="sourcePoint"/><mxPoint x="770" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n347" value="11. WS: ack(E1)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="608" as="sourcePoint"/><mxPoint x="550" y="608" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n348" value="12. Acknowledge(E1) → removed" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="646" as="sourcePoint"/><mxPoint x="330" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n349" value="Storage failure while handling → &lt;b&gt;no ack&lt;/b&gt;:&lt;br&gt;the outbox resends after the 30 s ack timeout." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="790" y="674" width="300" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
