ounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="180" y="400" width="240" height="56" as="geometry"/></mxCell><mxCell id="n164" value="POST /api/process" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="490" width="200" height="44" as="geometry"/></mxCell><mxCell id="n165" value="202&lt;br&gt;Accepted?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="220" y="560" width="160" height="90" as="geometry"/></mxCell><mxCell id="n166" value="Job = &lt;b&gt;Queued&lt;/b&gt;&lt;br&gt;(waits for processor events)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="700" width="200" height="52" as="geometry"/></mxCell><mxCell id="n167" value="Retry after Retry-After&lt;br&gt;(attempt not counted)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="500" y="400" width="180" height="52" as="geometry"/></mxCell><mxCell id="n168" value="503&lt;br&gt;Busy?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="515" y="560" width="150" height="90" as="geometry"/></mxCell><mxCell id="n169" value="4xx&lt;br&gt;rejected?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="515" y="690" width="150" height="90" as="geometry"/></mxCell><mxCell id="n170" value="Attempts&lt;br&gt;≥ 5?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="515" y="820" width="150" height="90" as="geometry"/></mxCell><mxCell id="n171" value="Exponential backoff&lt;br&gt;2 s → 60 s + jitter" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="700" y="838" width="140" height="52" as="geometry"/></mxCell><mxCell id="n172" value="Job = &lt;b&gt;Failed&lt;/b&gt;&lt;br&gt;(unreachable / rejected)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="960" width="190" height="50" as="geometry"/></mxCell><mxCell id="n173" value="&lt;b&gt;Safety net — Reconciler&lt;/b&gt; (every 30 s)&lt;br&gt;Queued/Processing silent &amp;gt; 60 s → GET /api/process/{id}:&lt;br&gt;• running → refresh · finished → apply result&lt;br&gt;• 404 (processor restarted) → back to Pending (max 3) → re-dispatch&lt;br&gt;• processor unreachable → leave the job alone" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="470" y="1050" width="370" height="110" as="geometry"/></mxCell><mxCell id="n174" value="Legal transition?&lt;br&gt;(state machine&lt;br&gt;+ version)" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="200" y="1170" width="200" height="110" as="geometry"/></mxCell><mxCell id="n175" value="Ignore (duplicate / late)&lt;br&gt;still ack" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="35" y="1197" width="150" height="56" as="geometry"/></mxCell><mxCell id="n176" value="Save results, then status&lt;br&gt;→ &lt;b&gt;Completed&lt;/b&gt; / &lt;b&gt;Failed&lt;/b&gt; · ack" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="180" y="1330" width="240" height="56" as="geometry"/></mxCell><mxCell id="n177" value="Broadcast to SSE subscribers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="190" y="1420" width="220" height="44" as="geometry"/></mxCell><mxCell id="n178" value="AuditPublisher → POST /api/audit&lt;br&gt;(outbox flag, retried until recorded)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="160" y="1500" width="280" height="52" as="geometry"/></mxCell><mxCell id="n179" value="Job finished" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="1600" width="180" height="44" as="geometry"/></mxCell><mxCell id="n180" value="Queue&lt;br&gt;full?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="1130" y="467" width="140" height="70" as="geometry"/></mxCell><mxCell id="n181" value="503 + Retry-After" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1115" y="380" width="170" height="40" as="geometry"/></mxCell><mxCell id="n182" value="Enqueue in bounded channel&lt;br&gt;202 Accepted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1080" y="580" width="240" height="56" as="geometry"/></mxCell><mxCell id="n183" value="Free worker picks job&lt;br&gt;→ &lt;b&gt;JobStarted&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1080" y="690" width="240" height="56" as="geometry"/></mxCell><mxCell id="n184" value="Analyze documents&lt;br&gt;Parallel.ForEachAsync (DOP 2)&lt;br&gt;per-document try/catch · throttled progress" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1055" y="790" width="290" height="70" as="geometry"/></mxCell><mxCell id="n185" value="All docs&lt;br&gt;failed?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="1125" y="910" width="150" height="90" as="geometry"/></mxCell><mxCell id="n186" value="&lt;b&gt;JobFailed&lt;/b&gt; event" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1330" y="935" width="140" height="40" as="geometry"/></mxCell><mxCell id="n187" value="&lt;b&gt;JobCompleted&lt;/b&gt; event&lt;br&gt;(summary + all results)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1085" y="1050" width="230" height="52" as="geometry"/></mxCell><mxCell id="n188" value="Outbox → WebSocket&lt;br&gt;resend on reconnect / ack timeout" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1065" y="1192" width="270" height="56" as="geometry"/></mxCell><mxCell id="n189" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="n159" target="n160"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n190" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;ex