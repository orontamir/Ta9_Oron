olor=#82b366;swimlaneFillColor=#F5FAF4;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="640" height="1640" as="geometry"/></mxCell><mxCell id="n162" value="Client: POST /api/jobs" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5FE;strokeColor=#0277BD;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="220" height="44" as="geometry"/></mxCell><mxCell id="n163" value="Valid request?&lt;br&gt;1–1000 docs · ≤100 KB each" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="220" y="180" width="220" height="90" as="geometry"/></mxCell><mxCell id="n164" value="400 ValidationProblem" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="170" height="40" as="geometry"/></mxCell><mxCell id="n165" value="Store documents, then job = &lt;b&gt;Pending&lt;/b&gt;&lt;br&gt;201 Created · signal dispatcher" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="210" y="310" width="240" height="56" as="geometry"/></mxCell><mxCell id="n166" value="Dispatcher: atomically claim due job&lt;br&gt;(lease = no double dispatch)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="210" y="400" width="240" height="56" as="geometry"/></mxCell><mxCell id="n167" value="POST /api/process" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="230" y="490" width="200" height="44" as="geometry"/></mxCell><mxCell id="n168" value="Dispatch outcome?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="230" y="570" width="200" height="90" as="geometry"/></mxCell><mxCell id="n169" value="Retry after Retry-After&lt;br&gt;(attempt not counted)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="170" height="52" as="geometry"/></mxCell><mxCell id="n170" value="Attempts ≥ max (5)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="180" height="80" as="geometry"/></mxCell><mxCell id="n171" value="Exponential backoff&lt;br&gt;2 s → 60 s + jitter" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="600" y="600" width="160" height="52" as="geometry"/></mxCell><mxCell id="n172" value="Job = &lt;b&gt;Failed&lt;/b&gt;&lt;br&gt;(unreachable / rejected)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="820" width="180" height="50" as="geometry"/></mxCell><mxCell id="n173" value="Job = &lt;b&gt;Queued&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="250" y="700" width="160" height="44" as="geometry"/></mxCell><mxCell id="n174" value="Queue full?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="1050" y="470" width="180" height="80" as="geometry"/></mxCell><mxCell id="n175" value="503 + Retry-After" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1055" y="380" width="170" height="40" as="geometry"/></mxCell><mxCell id="n176" value="Enqueue in bounded channel&lt;br&gt;202 Accepted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1010" y="580" width="260" height="56" as="geometry"/></mxCell><mxCell id="n177" value="Free worker picks job&lt;br&gt;→ &lt;b&gt;JobStarted&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1010" y="680" width="260" height="56" as="geometry"/></mxCell><mxCell id="n178" value="Analyze documents&lt;br&gt;Parallel.ForEachAsync (DOP 2)&lt;br&gt;per-document try/catch · throttled progress" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1000" y="780" width="280" height="70" as="geometry"/></mxCell><mxCell id="n179" value="All documents failed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="1040" y="900" width="200" height="90" as="geometry"/></mxCell><mxCell id="n180" value="&lt;b&gt;JobFailed&lt;/b&gt; event" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1050" y="1030" width="180" height="44" as="geometry"/></mxCell><mxCell id="n181" value="&lt;b&gt;JobCompleted&lt;/b&gt; event&lt;br&gt;(summary + all results)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1030" y="1100" width="220" height="52" as="geometry"/></mxCell><mxCell id="n182" value="Outbox → WebSocket&lt;br&gt;resend on reconnect / ack timeout" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1010" y="1200" width="260" height="56" as="geometry"/></mxCell><mxCell id="n183" value="Legal transition?&lt;br&gt;(state machine + version)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E