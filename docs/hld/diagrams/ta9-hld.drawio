metry></mxCell><mxCell id="n311" value="Job is &lt;b&gt;Processing&lt;/b&gt; on the old instance.&lt;br&gt;The instance crashes: queue, results and outbox are gone." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="330" height="50" as="geometry"/></mxCell><mxCell id="n312" value="1. find Queued/Processing jobs silent &gt; 60 s" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="216" as="sourcePoint"/><mxPoint x="710" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n313" value="2. GET /api/process/{id}" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="254" as="sourcePoint"/><mxPoint x="310" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n314" value="3. 404 Not Found (unknown job)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="292" as="sourcePoint"/><mxPoint x="510" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n315" value="4. if still stale: Processing → Pending, redispatchCount++ (version check)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="330" as="sourcePoint"/><mxPoint x="710" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n316" value="5. signal (wake up)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#777777;fontColor=#777777;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="368" as="sourcePoint"/><mxPoint x="910" y="368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n317" value="6. claim job (lease)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="406" as="sourcePoint"/><mxPoint x="710" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n318" value="7. POST /api/process {jobId, documents}" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="444" as="sourcePoint"/><mxPoint x="310" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n319" value="8. 202 Accepted" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#1f5fa8;fontColor=#1f5fa8;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="482" as="sourcePoint"/><mxPoint x="910" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n320" value="9. WS: JobStarted … JobCompleted" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="520" as="sourcePoint"/><mxPoint x="1110" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n321" value="10. save results → Completed" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="558" as="sourcePoint"/><mxPoint x="710" y="558" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n322" value="11. WS: acks" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#2e7d32;fontColor=#2e7d32;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="596" as="sourcePoint"/><mxPoint x="310" y="596" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n323" value="Safe because analysis is deterministic and idempotent.&lt;br&gt;After 3 redispatches the job is marked &lt;b&gt;Failed&lt;/b&gt; (poison-job guard).&lt;br&gt;If an event arrives meanwhile, the version check makes the event win." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="360" y="624" width="420" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page7" name="5c. Sequence — WebSocket Reconnect"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n324" value="&lt;b&gt;Sequence Diagram — WebSocket disconnect, reconnect and replay&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="n325" value="JobRunner" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#D5E8D4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="45" y="80" width="130" height="54" as="geometry"/></mxCell><mxCell id="n326" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9E9E9E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="134" as="sourcePoint"/><mxPoint x="110" y="960" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n327" valu