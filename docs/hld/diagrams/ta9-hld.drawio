ontColor=#1f5fa8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc51" target="cc53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="130"/></Array></mxGeometry></mxCell><mxCell id="cc64" value="conditional replace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#1f5fa8;fontColor=#1f5fa8;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc52" target="cc53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc65" value="on success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc52" target="cc54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc66" value="Publish (TryWrite)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#7b1fa2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc54" target="cc55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc67" value="SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#7b1fa2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cc55" target="cc56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cc68" value="&lt;b&gt;Guarantees&lt;/b&gt;&lt;br&gt;• two writers can never overwrite each other (no lost update)&lt;br&gt;• a job is never dispatched twice at the same time (lease)&lt;br&gt;• events of one processor are applied in order; duplicates and late events are no-ops&lt;br&gt;• no lock is held across I/O; no thread blocks waiting for another writer" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="430" y="650" width="600" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-websocket" name="9. WebSocket — Connection &amp; Outbox"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ws1" value="&lt;b&gt;WebSocket link — connection, outbox and receiver behavior&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="ws2" value="A. Connection lifecycle — Processor (JobServiceEventsClient)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;container=1;collapsible=0;rounded=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#F7FBF6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="760" height="470" as="geometry"/></mxCell><mxCell id="ws3" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="26" height="26" as="geometry"/></mxCell><mxCell id="ws4" value="&lt;b&gt;Connecting&lt;/b&gt;&lt;br&gt;ConnectAsync (timeout 10 s)&lt;br&gt;keep-alive 15 s" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="140" y="140" width="190" height="66" as="geometry"/></mxCell><mxCell id="ws5" value="&lt;b&gt;Connected&lt;/b&gt;&lt;br&gt;MarkConnected():&lt;br&gt;all unacked events due again" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="450" y="140" width="220" height="66" as="geometry"/></mxCell><mxCell id="ws6" value="&lt;b&gt;Streaming&lt;/b&gt;&lt;br&gt;send loop: TakeDue → SendAsync&lt;br&gt;receive loop: ack → Acknowledge&lt;br&gt;wake-up: new event or 5 s tick" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="450" y="290" width="220" height="86" as="geometry"/></mxCell><mxCell id="ws7" value="&lt;b&gt;Disconnected&lt;/b&gt;&lt;br&gt;MarkDisconnected():&lt;br&gt;lifecycle kept · progress dropped" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="140" y="290" width="190" height="72" as="geometry"/></mxCell><mxCell id="ws8" value="&lt;b&gt;Backoff&lt;/b&gt;&lt;br&gt;1 s → 2 s → 4 s … ≤ 30 s&lt;br&gt;± 20 % jitter" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="140" y="430" width="190" height="62" as="geometry"/></mxCell><mxCell id="ws9" value="&lt;b&gt;Closed&lt;/b&gt;&lt;br&gt;graceful close on shutdown" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="520" y="450" width="160" height="50" as="geometry"/></mxCell><mxCell id="ws10" value="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws3" target="ws4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws11" value="success&lt;br&gt;(attempts = 0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#2E7D32;fontColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws4" target="ws5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws12" value="replay pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#2E7D32;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws5" target="ws6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws13" value="server closed · network error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#C62828;fontColor=#C62828;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws6" target="ws7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws14" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#C62828;fontColor=#C62828;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws4" target="ws7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws15" value="attempt++" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws7" target="ws8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws16" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws8" target="ws4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="461"/><mxPoint x="110" y="190"/></Array></mxGeometry></mxCell><mxCell id="ws17" value="shutdown" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws6" target="ws9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws18" value="B. Outbox entry lifecycle — Processor (EventOutbox)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;container=1;collapsible=0;rounded=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#F7FBF6;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="760" height="470" as="geometry"/></mxCell><mxCell id="ws19" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="26" height="26" as="geometry"/></mxCell><mxCell id="ws20" value="Outbox full?&lt;br&gt;(10 000)" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="975" y="128" width="150" height="90" as="geometry"/></mxCell><mxCell id="ws21" value="&lt;b&gt;Dropped&lt;/b&gt; + error log&lt;br&gt;reconciler recovers the job" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="190" height="56" as="geometry"/></mxCell><mxCell id="ws22" value="&lt;b&gt;Pending&lt;/b&gt;&lt;br&gt;(not sent yet)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="160" height="60" as="geometry"/></mxCell><mxCell id="ws23" value="&lt;b&gt;Sent&lt;/b&gt;&lt;br&gt;SentAt = now&lt;br&gt;waiting for ack" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="1400" y="140" width="160" height="66" as="geometry"/></mxCell><mxCell id="ws24" value="&lt;b&gt;Acknowledged&lt;/b&gt;&lt;br&gt;removed from outbox" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1400" y="300" width="160" height="60" as="geometry"/></mxCell><mxCell id="ws25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws19" target="ws20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws26" value="new lifecycle event&lt;br&gt;(Started · Completed ·&lt;br&gt;Failed · Cancelled)" style="text;html=1;fontSize=10;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="850" y="200" width="130" height="50" as="geometry"/></mxCell><mxCell id="ws27" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#C62828;fontColor=#C62828;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws20" target="ws21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws20" target="ws22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws29" value="TakeDue (in order)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws22" target="ws23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws30" value="ack(eventId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#2E7D32;fontColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws23" target="ws24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ws31" value="reconnect (MarkConnected)&lt;br&gt;or no ack within 30 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;strokeColor=#C62828;fontColor=#C62828;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws23" target="ws22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="115"/><mxPoint x="1260" y="115"/></Array></mxGeometry></mxCell><mxCell id="ws32" value="&lt;b&gt;Progress events&lt;/b&gt; are not entries:&lt;br&gt;• dropped while disconnected&lt;br&gt;• coalesced to the latest per job while connected&lt;br&gt;• sent once, never acked or replayed&lt;br&gt;• a terminal event discards the job&#x27;s pending progress" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1150" y="400" width="260" height="110" as="geometry"/></mxCell><mxCell id="ws33" value="C. Receiver — Job Service (ProcessorEventsEndpoint, one sequential loop per connection)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;container=1;collapsible=0;rounded=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#F6F9FD;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1560" height="300" as="geometry"/></mxCell><mxCell id="ws34" value="message received&lt;br&gt;(≤ 16 MB)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="140" height="50" as="geometry"/></mxCell><mxCell id="ws35" value="valid&lt;br&gt;envelope?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="280" y="640" width="110" height="90" as="geometry"/></mxCell><mxCell id="ws36" value="skip&lt;br&gt;&lt;b&gt;no ack&lt;/b&gt; (no eventId)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="260" y="780" width="150" height="56" as="geometry"/></mxCell><mxCell id="ws37" value="&lt;b&gt;ProcessorEventHandler&lt;/b&gt;&lt;br&gt;state machine + optimistic concurrency&lt;br&gt;results stored before status" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="650" width="260" height="70" as="geometry"/></mxCell><mxCell id="ws38" value="outcome?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="770" y="640" width="110" height="90" as="geometry"/></mxCell><mxCell id="ws39" value="&lt;b&gt;Applied&lt;/b&gt; → ack" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=1